{
  "name": "yerel",
  "displayName": "yerel",
  "description": "yerel description",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "yerel.extractStrings",
        "title": "Extract Strings to i18n",
        "category": "Yerel"
      },
      {
        "command": "yerel.extractFromSelection",
        "title": "Extract Selected Text to i18n",
        "category": "Yerel"
      },
      {
        "command": "yerel.configureSettings",
        "title": "Configure i18n Settings",
        "category": "Yerel"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "yerel.extractFromSelection",
          "when": "editorHasSelection",
          "group": "yerel"
        }
      ],
      "explorer/context": [
        {
          "command": "yerel.extractStrings",
          "when": "resourceExtname =~ /\\.(html|js|ts|vue|jsx|tsx)$/",
          "group": "yerel"
        }
      ]
    },
    "configuration": {
      "title": "Yerel i18n",
      "properties": {
        "yerel.translationFunction": {
          "type": "string",
          "default": "$t",
          "description": "Translation function name (e.g., $t, t, i18n.t)"
        },
        "yerel.templateSyntax": {
          "type": "string",
          "default": "{{ {func}('{key}') }}",
          "description": "Template syntax for translations. Use {func} for function and {key} for translation key"
        },
        "yerel.localesPath": {
          "type": "string",
          "default": "locales",
          "description": "Path to locales directory"
        },
        "yerel.supportedLanguages": {
          "type": "array",
          "default": ["en", "tr", "ru"],
          "description": "List of supported language codes"
        },
        "yerel.keyNamingStyle": {
          "type": "string",
          "enum": ["camelCase", "snake_case", "dot.notation"],
          "default": "dot.notation",
          "description": "Key naming convention"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "yarn run check-types && yarn run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "yarn run check-types && yarn run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.32.0",
    "esbuild": "^0.25.8",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
